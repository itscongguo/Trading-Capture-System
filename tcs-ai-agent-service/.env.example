# Gemini API Configuration
# Set GEMINI_API_KEY in your shell environment (e.g., ~/.zshrc)
# GEMINI_API_KEY=

# Finnhub API Configuration
# Set FINNHUB_API_KEY in your shell environment (e.g., ~/.zshrc)
# FINNHUB_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8090

# LLM Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024

# Embeddings Configuration
EMBEDDING_MODEL=models/embedding-001

# Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=finnhub_news

# News Loading Configuration
NEWS_REFRESH_INTERVAL_HOURS=1
NEWS_CATEGORIES=general
DEFAULT_SYMBOLS=AAPL,GOOGL,MSFT
